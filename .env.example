# --- Zolvency Protocol Core Setup (v6.0) ---
# Contratos core: soul, nexus, zpay.
# Config de interop cross-chain (Axelar/EVM/Cosmos/Solana) vive em devfelipenunes/zolvency-interop.

# Admin and Treasury
ADMIN_SECRET=S...     # Secret key for contract admin
ADMIN_PUBLIC=G...     # Public key for contract admin
DEPLOYER_SECRET=S...  # Secret key for deployment
TREASURY_ADDRESS=G... # Public address for fees

# Network (testnet | mainnet | local)
STELLAR_NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org

# --- Contract IDs (Populate after deploy) ---
NEXUS_CONTRACT_ID=C...
SOUL_CONTRACT_ID=C...
ZPAY_CONTRACT_ID=C...
