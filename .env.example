# --- Zolvency Protocol Setup (v6.0) ---

# Admin and Treasury
ADMIN_SECRET=S...   # Secret key for contract admin
TREASURY_ADDRESS=G... # Public address for fees

# Network (testnet | mainnet | local)
STELLAR_NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org

# --- Contract IDs (Populate after deploy) ---
REGISTRY_CONTRACT_ID=C...
GITHUB_TOKEN_CONTRACT_ID=C...
BANK_TOKEN_CONTRACT_ID=C...
ACTIVITY_TOKEN_CONTRACT_ID=C...

# --- ZK Proof Signer (Server) ---
# This is the address that signs the zkTLS/zk-email proofs
AUTHORIZED_SIGNER_ADDRESS=G...
