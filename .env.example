ADMIN_PUBLIC=G...     # Public key for contract admin
DEPLOYER_SECRET=S...  # Secret key for deployment
TREASURY_ADDRESS=G... # Public address for fees
USER_EVM_ADDRESS=0x... # EVM user address for testing

# Network (testnet | mainnet | local)
